<Page x:Class="PaymentApp.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи (CRUD)" Tag="Таблица пользователей"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridUser" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="90"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="ButtonEdit_Click"
                                    ToolTip="Редактировать пользователя"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="ButtonAdd" Content="Добавить" Width="140"
                    Click="ButtonAdd_Click" ToolTip="Добавить пользователя"/>
            <Button x:Name="ButtonDel" Content="Удалить" Width="140"
                    Click="ButtonDel_Click" ToolTip="Удалить выбранных"/>
        </StackPanel>
    </Grid>
</Page>