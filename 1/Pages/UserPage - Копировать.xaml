<Page x:Class="PaymentApp.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи" Tag="Пользователи">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                   Margin="0,10,0,10">
            <TextBlock Text="Введите ФИО:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="fioFilterTextBox" MinWidth="140" Margin="0,0,10,0"
                     TextChanged="fioFilterTextBox_TextChanged"/>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="sortComboBox" SelectedIndex="0" Width="140"
                      Margin="0,0,10,0" SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      Checked="onlyAdminCheckBox_Checked"
                      Unchecked="onlyAdminCheckBox_Unchecked"/>
            <Button x:Name="clearFiltersButton" Content="Очистить фильтр"
                    Width="140" Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1"
                  HorizontalContentAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="8"
                            Padding="8" Width="220">
                        <StackPanel>
                            <Image Width="200" Height="180" Stretch="UniformToFill"
                                   Source="{Binding Photo, TargetNullValue={x:Null}}"/>
                            <TextBlock Text="{Binding FIO}" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Role}" HorizontalAlignment="Center"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>