<Page x:Class="PaymentApp.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователь" Tag="Редактирование пользователя">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" FontSize="16" VerticalAlignment="Center"/>
        <TextBox x:Name="TBLogin" Grid.Row="0" Grid.Column="1"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,5" ToolTip="Введите логин"/>

        <TextBlock Text="Пароль" Grid.Row="1" FontSize="16" VerticalAlignment="Center"/>
        <TextBox x:Name="TBPass" Grid.Row="1" Grid.Column="1"
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,5" ToolTip="Введите пароль"/>

        <TextBlock Text="Роль" Grid.Row="2" FontSize="16" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbRole" Grid.Row="2" Grid.Column="1"
                  SelectedItem="{Binding Role}" Margin="0,5,0,5">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="User"/>
        </ComboBox>

        <TextBlock Text="ФИО" Grid.Row="3" FontSize="16" VerticalAlignment="Center"/>
        <TextBox x:Name="TBFio" Grid.Row="3" Grid.Column="1"
                 Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,5" ToolTip="Введите ФИО"/>

        <TextBlock Text="Фото (URL)" Grid.Row="4" FontSize="16" VerticalAlignment="Center"/>
        <TextBox x:Name="TBPhoto" Grid.Row="4" Grid.Column="1"
                 Text="{Binding Photo, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,5" ToolTip="Путь к фото"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="140"
                    Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="140"
                    Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>