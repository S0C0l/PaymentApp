<Page x:Class="PaymentApp.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категория" Tag="Редактирование категории">
    <StackPanel Margin="40" VerticalAlignment="Center">
        <TextBlock Text="Название категории" FontSize="16" Margin="0,0,0,8"/>
        <TextBox x:Name="TBCategoryName"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Width="300" Height="30" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="140" Click="ButtonSaveCategory_Click"/>
            <Button Content="Очистить" Width="140" Click="ButtonClean_Click"/>
        </StackPanel>
    </StackPanel>
</Page>