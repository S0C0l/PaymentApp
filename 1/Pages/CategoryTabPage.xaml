<Page x:Class="PaymentApp.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категории (CRUD)" Tag="Таблица категорий"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridCategory" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="*"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="ButtonEdit_Click"
                                    ToolTip="Изменить категорию"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,10,0,10">
            <Button x:Name="ButtonAdd" Content="Добавить" Width="140" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" Width="140" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>