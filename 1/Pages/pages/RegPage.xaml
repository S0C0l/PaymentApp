<Page x:Class="PaymentApp.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Tag="Регистрация">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,10,0">
            <Label Content="Введите логин"/>
            <Label Content="Введите пароль" Margin="0,10,0,0"/>
            <Label Content="Подтвердите пароль" Margin="0,10,0,0"/>
            <Label Content="Выберите роль" Margin="0,10,0,0"/>
            <Label Content="Введите ФИО" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Width="260" Margin="10,0,0,0">
            <TextBox x:Name="txtbxLog" Height="30" ToolTip="Введите логин"
                     TextChanged="txtbxLog_TextChanged"/>
            <PasswordBox x:Name="passBxFrst" Height="30" Margin="0,10,0,0"
                         ToolTip="Введите пароль"/>
            <PasswordBox x:Name="passBxScnd" Height="30" Margin="0,10,0,0"
                         ToolTip="Повторите пароль"/>
            <ComboBox x:Name="comboBxRole" Height="30" Margin="0,10,0,0"
                      ToolTip="Выберите роль">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>
            <TextBox x:Name="txtbxFIO" Height="30" Margin="0,10,0,0"
                     ToolTip="Введите ФИО"/>
            <Button x:Name="regButton" Content="Зарегистрироваться"
                    Margin="0,20,0,0" Click="regButton_Click"/>
        </StackPanel>
    </Grid>
</Page>