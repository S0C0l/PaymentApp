<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBackground" Color="#2D2D30"/>

    <SolidColorBrush x:Key="HeaderBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="HeaderForeground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Accent"           Color="#0198AF"/>
       <SolidColorBrush x:Key="TextForeground"   Color="#1E1E1E"/>

    <Style TargetType="Button">
        <Setter Property="Height"   Value="35"/>
        <Setter Property="Width"    Value="130"/>
        <Setter Property="Margin"   Value="6"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor"   Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height"     Value="30"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Padding"    Value="4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#3E3E42"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#555555"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height"     Value="30"/>
        <Setter Property="Padding"    Value="4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#3E3E42"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#555555"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>

        <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

</ResourceDictionary>