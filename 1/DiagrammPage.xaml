<Page x:Class="PaymentApp.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Диаграммы" Tag="Диаграммы">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="0" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbUser" Width="200" DisplayMemberPath="FIO" 
                      SelectionChanged="UpdateChart" Margin="0,0,20,0"/>

            <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbDiagram" Width="150" 
                      SelectionChanged="UpdateChart" Margin="0,0,20,0"/>

            <Button Content="Экспорт в Excel" Width="130" Click="ExportExcel_Click"/>
            <Button Content="Экспорт в Word" Width="130" Click="ExportWord_Click"/>
        </WrapPanel>

        <!-- Место для графика (пока просто пустая рамка) -->
        <Border Grid.Row="1" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Text="Здесь будет график" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>