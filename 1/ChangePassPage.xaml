<Page x:Class="PaymentApp.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля" Tag="Смена пароля">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Введите логин" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="TbLogin" Height="30"/>

            <TextBlock Text="Старый пароль" FontSize="14" Margin="0,10,0,5"/>
            <PasswordBox x:Name="CurrentPasswordBox" Height="30"/>

            <TextBlock Text="Новый пароль" FontSize="14" Margin="0,10,0,5"/>
            <PasswordBox x:Name="NewPasswordBox" Height="30"/>

            <TextBlock Text="Повторите новый пароль" FontSize="14" Margin="0,10,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30"/>

            <Button Content="Сохранить" Width="150" Margin="0,20,0,0" Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>
</Page>