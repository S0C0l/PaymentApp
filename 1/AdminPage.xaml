<Page x:Class="PaymentApp.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администратор" Tag="Администратор">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnTab1" Content="Таблица пользователей" 
                        Width="200" Height="50" Margin="10" Click="BtnTab1_Click"/>

                <Button x:Name="BtnTab2" Content="Таблица категорий" 
                        Width="200" Height="50" Margin="10" Click="BtnTab2_Click"/>

                <Button x:Name="BtnTab3" Content="Таблица платежей" 
                        Width="200" Height="50" Margin="10" Click="BtnTab3_Click"/>
            </StackPanel>

            <Button x:Name="BtnTab4" Content="Диаграммы и экспорт" 
                    Width="200" Height="50" Margin="10,40,10,10" 
                    HorizontalAlignment="Center" Click="BtnTab4_Click"/>

        </StackPanel>
    </Grid>
</Page>