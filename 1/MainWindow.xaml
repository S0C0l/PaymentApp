<Window x:Class="PaymentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт платежей" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ButtonBack" Grid.Column="0" Content="Назад" Width="100"
                    HorizontalAlignment="Left" Margin="10,0,0,0" Click="ButtonBack_Click"/>

            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Авторизация"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource HeaderForeground}"/>

            <Button x:Name="ButtonTheme" Grid.Column="2" Content="Сменить тему" Width="130"
                    HorizontalAlignment="Right" Margin="0,0,10,0" Click="ButtonTheme_Click"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>

        <Border Grid.Row="2" Background="{DynamicResource FooterBackground}">
            <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,20,0" FontSize="13" Foreground="{DynamicResource HeaderForeground}"/>
        </Border>
    </Grid>
</Window>