<Page x:Class="PaymentApp.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" Tag="Авторизация">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Логин -->
        <Label Grid.Row="1" Grid.Column="0" Content="Логин"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,10,80"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="1" Grid.Column="1"
                 Width="260" Height="32" Margin="0,0,0,80"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 ToolTip="Введите логин"/>
        <Label x:Name="lblHintLogin" Grid.Row="1" Grid.Column="1"
               Content="Введите логин" Foreground="Gray"
               IsHitTestVisible="False" Margin="8,0,0,80"
               VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!-- Пароль -->
        <Label Grid.Row="1" Grid.Column="0" Content="Пароль"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,10,20"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"
                     Width="260" Height="32" Margin="0,0,0,20"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     ToolTip="Введите пароль"/>
        <Label x:Name="lblHintPass" Grid.Row="1" Grid.Column="1"
               Content="Введите пароль" Foreground="Gray"
               IsHitTestVisible="False" Margin="8,0,0,20"
               VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!-- Капча -->
        <Label x:Name="labelCaptcha" Grid.Row="1" Grid.Column="0"
               Content="Капча" Visibility="Hidden"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,10,120"/>
        <TextBox x:Name="captcha" Grid.Row="1" Grid.Column="1"
                 Width="200" Height="40" Margin="0,0,0,120"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsReadOnly="True" FontSize="18" FontWeight="Bold"
                 FontStyle="Italic" Foreground="Red"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 Visibility="Hidden"/>
        <TextBox x:Name="captchaInput" Grid.Row="1" Grid.Column="1"
                 Width="200" Height="30" Margin="0,55,0,65"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Visibility="Hidden" ToolTip="Введите символы с картинки"/>
        <Button x:Name="submitCaptcha" Grid.Row="1" Grid.Column="1"
                Content="Проверить капчу" Width="160"
                Margin="0,120,0,0" HorizontalAlignment="Left"
                VerticalAlignment="Center" Visibility="Hidden"
                Click="submitCaptcha_Click"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,230,0,0"
                    Orientation="Vertical" HorizontalAlignment="Left">
            <Button x:Name="ButtonEnter" Content="Вход" Width="260"
                    ToolTip="Войти в систему" Click="ButtonEnter_OnClick"/>
            <Button x:Name="ButtonReg" Content="Регистрация" Width="260"
                    ToolTip="Перейти к регистрации" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля"
                    Width="260" ToolTip="Сменить пароль"
                    Click="ButtonChangePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>