<Page x:Class="PaymentApp.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователь" Tag="Пользователь">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="TBLogin" Grid.Row="0" Grid.Column="1" 
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,5" ToolTip="Введите логин"/>

        <TextBlock Text="Пароль" Grid.Row="1" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="TBPass" Grid.Row="1" Grid.Column="1" 
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,5" ToolTip="Введите пароль"/>

        <TextBlock Text="Роль" Grid.Row="2" VerticalAlignment="Center" FontSize="14"/>
        <ComboBox x:Name="cmbRole" Grid.Row="2" Grid.Column="1" 
                  SelectedItem="{Binding Role}" Margin="0,5,0,5" ToolTip="Выберите роль">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="User"/>
        </ComboBox>

        <TextBlock Text="ФИО" Grid.Row="3" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="TBFio" Grid.Row="3" Grid.Column="1" 
                 Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,5" ToolTip="Введите ФИО"/>

        <TextBlock Text="Фото (URL)" Grid.Row="4" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="TBPhoto" Grid.Row="4" Grid.Column="1" 
                 Text="{Binding Photo, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,5" ToolTip="Путь к фото"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="120" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="120" Click="ButtonClean_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>